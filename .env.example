APP_NAME="Garmin Connector"
APP_ENV=production
APP_DEBUG=false

# Generate with: docker compose run --rm app php artisan key:generate --show
# Changing this key signs out every connected Claude client.
APP_KEY=

# Public address of this server, without a trailing slash.
APP_URL=https://garmin-mcp.befu.ro

# Domain the container requests an HTTPS certificate for.
SERVER_NAME=garmin-mcp.befu.ro

# Create at https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# Generate with: docker compose run --rm -it app php artisan mcp:hash-password
# Paste the whole output line, including the single quotes.
MCP_OWNER_PASSWORD_HASH=

# Set only when running behind your own reverse proxy, as comma-separated IPs.
TRUSTED_PROXIES=

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
