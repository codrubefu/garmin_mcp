APP_NAME="Garmin Connector"
APP_ENV=production
APP_DEBUG=false

# Generate with: docker compose run --rm app php artisan key:generate --show
# Changing this key signs out every connected Claude client.
APP_KEY=

# Public address of this server, without a trailing slash.
APP_URL=https://garmin-mcp.befu.ro

# Domain the container requests an HTTPS certificate for.
SERVER_NAME=garmin-mcp.befu.ro

# Users, separated by commas: lowercase letters, digits and underscores.
# Each one gets its own endpoint, e.g. https://garmin-mcp.befu.ro/mcp/codrut
MCP_USERS=codrut,vio

# For every user, add the two lines below with the name in capitals.
# Garmin key: create it at https://connect.garmin.com/app/settings/personalApiToken
# Password hash: docker compose run --rm -it app php artisan mcp:hash-password codrut
# Paste the whole output line of the command, including the single quotes.
GARMIN_API_KEY_CODRUT=
MCP_PASSWORD_HASH_CODRUT=

GARMIN_API_KEY_VIO=
MCP_PASSWORD_HASH_VIO=

# Set only when running behind your own reverse proxy, as comma-separated IPs.
TRUSTED_PROXIES=

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
